<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#000000">

    <!-- TOP HALF: CAMERA STREAM (50% SCREEN) -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#111111">
        
        <WebView
            android:id="@+id/webViewCam"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- Scanlines overlay -->
        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#33000000" />
        
        <!-- LIVE Badge -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="LIVE"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="11sp"
            android:backgroundTint="#EF4444"
            android:background="@drawable/pill_bg"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:layout_margin="12dp" />
    </RelativeLayout>

    <!-- BOTTOM HALF: HARDWARE STATUS, SENSOR READINGS & LIVE CODE LOGS (50% SCREEN) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:padding="12dp"
        android:background="#0a0c10">

        <!-- HARDWARE CAPSULES & US SENSOR ROW -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- CAM Capsule -->
            <TextView
                android:id="@+id/tvCamStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CAM"
                android:textColor="#000000"
                android:textStyle="bold"
                android:textSize="11sp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:backgroundTint="#EF4444"
                android:background="@drawable/pill_bg"
                android:layout_marginEnd="6dp" />

            <!-- AI API Capsule -->
            <TextView
                android:id="@+id/tvAiStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="AI API"
                android:textColor="#000000"
                android:textStyle="bold"
                android:textSize="11sp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:backgroundTint="#EF4444"
                android:background="@drawable/pill_bg"
                android:layout_marginEnd="6dp" />

            <!-- HC Sensor Capsule -->
            <TextView
                android:id="@+id/tvHcStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="HC SENSOR"
                android:textColor="#000000"
                android:textStyle="bold"
                android:textSize="11sp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:backgroundTint="#EF4444"
                android:background="@drawable/pill_bg" />

            <!-- Refresh Button -->
            <ImageView
                android:id="@+id/ivRefresh"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_marginStart="8dp"
                android:src="@android:drawable/ic_popup_sync"
                android:tint="#58a6ff"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Refresh connections" />

            <!-- Spacer -->
            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <!-- US Sensor Distance Reading -->
            <TextView
                android:id="@+id/tvDistance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="US: -- cm"
                android:textColor="#22C55E"
                android:textStyle="bold"
                android:textSize="13sp"
                android:typeface="monospace"
                android:layout_marginEnd="10dp" />

            <!-- Settings Gear -->
            <ImageView
                android:id="@+id/ivSettings"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:src="@android:drawable/ic_menu_preferences"
                android:tint="#888888"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Settings" />
        </LinearLayout>

        <!-- COMPACT AI DIRECTIVE BANNER (NO HUGE BLOCK) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/banner_bg"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:layout_marginTop="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="AI > "
                android:textColor="#22C55E"
                android:textStyle="bold"
                android:textSize="13sp"
                android:typeface="monospace" />

            <TextView
                android:id="@+id/tvAiResult"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="VisionGuide Ready"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold"
                android:maxLines="2"
                android:ellipsize="end" />
        </LinearLayout>

        <!-- SERVER STATS ROW -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="4dp">

            <TextView
                android:id="@+id/tvLatency"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Latency: -- ms"
                android:textColor="#8b949e"
                android:textSize="11sp"
                android:typeface="monospace" />

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/tvPhoneIp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Phone IP: ..."
                android:textColor="#8b949e"
                android:textSize="11sp"
                android:typeface="monospace" />
        </LinearLayout>

        <!-- LIVE SCROLLABLE OUTPUTS OF CODE & LOGS -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:background="@drawable/terminal_bg"
            android:padding="8dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="● LIVE CONSOLE OUTPUT"
                android:textColor="#58a6ff"
                android:textSize="10sp"
                android:textStyle="bold"
                android:typeface="monospace"
                android:letterSpacing="0.05"
                android:layout_marginBottom="4dp" />

            <ScrollView
                android:id="@+id/svEventLog"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:fillViewport="true"
                android:scrollbars="vertical">

                <TextView
                    android:id="@+id/tvEventLog"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#7ee787"
                    android:textSize="11sp"
                    android:typeface="monospace"
                    android:lineSpacingExtra="3dp"
                    android:text="[System] Initializing VisionGuide...\n[System] Awaiting connections..." />
            </ScrollView>
        </LinearLayout>

    </LinearLayout>
</LinearLayout>
